---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "日常记录" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">正在进行的项目</div>
  </div>

  <HorizontalCard
    title="AI全自动裁剪EL图片工具"
    img="/images/projects/ai-el-crop.png"
    desc="光伏组件图像识别EL裁剪工具"
    url="https://www.acheng9616.com/"
    badge="运行中"
  />
  <div class="divider my-0"></div>
  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">已完成的项目</div>
  </div>

  <HorizontalCard
    title="个人网站主页"
    img="/images/site/网站封面.webp"
    desc="我的网站主页，有我各个的媒体平台介绍，有关于我的信息"
    url="https://www.acheng9616.com/"
    badge="运行中"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="AI全自动裁剪EL图片工具"
    img="/images/projects/ai-el-crop.png"
    desc="光伏组件图像识别EL裁剪工具"
    url="https://EL.acheng9616.com/"
