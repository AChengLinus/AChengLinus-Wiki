---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DailyListItem from "../../components/daily/DailyListItem.astro";
import { getCollection } from "astro:content";
import dayjs from "dayjs";

export async function getStaticPaths({ paginate }) {
  const items = await getCollection("daily");
  items.sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
  return paginate(items, { pageSize: 10 });
}

const { page } = Astro.props;

const PAGE_TITLE = "日常分享和吐槽";

// 全量索引：搜索与筛选都要跨分页，构建时把全部条目序列化进页面
const allItems = await getCollection("daily");
allItems.sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());

const WEEK = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
const todayStr = dayjs().format("YYYY-MM-DD");
const fmtDate = (d) => dayjs(d).format("YYYY-MM-DD");
const fmtWeek = (d) => WEEK[dayjs(d).day()];

/** 分类：AI 日报 / 日常 */
const kindOf = (badge) => (badge === "AI日报" ? "ai" : "life");

const searchIndex = allItems.map((item) => ({
  t: item.data.title,
  d: item.data.description,
  u: `/daily/${item.slug}`,
  i: item.data.heroImage || "",
  b: item.data.badge || "",
  g: item.data.tags || [],
  s: fmtDate(item.data.updatedDate),
  k: kindOf(item.data.badge),
}));

const totalCount = searchIndex.length;
const aiCount = searchIndex.filter((x) => x.k === "ai").length;
const lifeCount = totalCount - aiCount;
const searchJson = JSON.stringify(searchIndex).replace(/</g, "\\u003c");

// 页码
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const pageUrl = (n) => (n === 1 ? "/daily" : `/daily/${n}`);

/** 页数多时折叠成 1 … 4 5 6 … 12 */
function visiblePages(cur, last) {
  if (last <= 7) return Array.from({ length: last }, (_, i) => i + 1);
  const keep = new Set([1, last, cur - 1, cur, cur + 1].filter((n) => n >= 1 && n <= last));
  const nums = [...keep].sort((a, b) => a - b);
  const out = [];
  let prev = 0;
  for (const n of nums) {
    if (prev && n - prev > 1) out.push("…");
    out.push(n);
    prev = n;
  }
  return out;
}
const pages = visiblePages(currentPage, totalPages);
const SUGGESTIONS = ["AI", "模型", "Claude", "开源", "算力", "吐槽", "驾校"];
---

<BaseLayout title={PAGE_TITLE} sideBarActiveItemID="daily">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <div class="w-full text-3xl font-bold">{PAGE_TITLE}</div>
      <p class="mt-1 text-sm opacity-60">文字记录 · AI 早报与生活琐碎</p>
    </div>
    <div class="text-sm opacity-50">共 {totalCount} 条 · 第 {currentPage} / {totalPages} 页</div>
  </div>

  <!-- 搜索 / 筛选栏 -->
  <div class="sticky top-0 z-20 -mx-2 mb-2 bg-base-100/90 px-2 pb-2 pt-2 backdrop-blur">
    <div class="relative">
      <svg
        class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 opacity-40"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"></path>
      </svg>
      <input
        id="daily-search"
        type="text"
        placeholder="搜索标题、摘要、标签、日期…"
        autocomplete="off"
        spellcheck="false"
        class="input input-bordered h-11 w-full rounded-lg pl-10 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30"
      />
      <button
        id="daily-search-clear"
        type="button"
        aria-label="清空搜索"
        class="absolute right-2 top-1/2 hidden h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full text-lg leading-none opacity-40 hover:bg-base-200 hover:opacity-100"
      >
        ×
      </button>
    </div>

    <!-- 分类筛选 + 搜索提示 -->
    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
      <div class="join" id="daily-filter" role="group" aria-label="内容分类">
        <button type="button" class="btn btn-xs join-item" data-filter="all">
          全部 <span class="opacity-50">{totalCount}</span>
        </button>
        <button type="button" class="btn btn-xs join-item" data-filter="ai">
          AI 日报 <span class="opacity-50">{aiCount}</span>
        </button>
        <button type="button" class="btn btn-xs join-item" data-filter="life">
          日常 <span class="opacity-50">{lifeCount}</span>
        </button>
      </div>
      <span class="hidden opacity-40 sm:inline">|</span>
      <span class="opacity-50">支持标题 / 摘要 / 标签 / 日期<span class="hidden sm:inline"> · 按 <kbd class="kbd kbd-xs">/</kbd> 聚焦</span></span>
    </div>

    <div id="daily-search-meta" class="mt-2 hidden text-xs opacity-60"></div>
    <div id="daily-suggest" class="mt-2 flex flex-wrap items-center gap-1.5 text-xs">
      <span class="opacity-50">试试：</span>
      {
        SUGGESTIONS.map((s) => (
          <button
            type="button"
            class="daily-suggest-btn rounded-full bg-base-200 px-2 py-0.5 opacity-70 transition hover:bg-base-300 hover:opacity-100"
            data-q={s}
          >
            {s}
          </button>
        ))
      }
    </div>
  </div>

  <!-- 默认视图：分页列表 -->
  <div id="daily-default">
    <ul class="space-y-3">
      {
        page.data.map((item) => (
          <li>
            <DailyListItem
              title={item.data.title}
              desc={item.data.description}
              img={item.data.heroImage}
              badge={item.data.badge}
              date={fmtDate(item.data.updatedDate)}
              weekday={fmtWeek(item.data.updatedDate)}
              tags={item.data.tags}
              isToday={fmtDate(item.data.updatedDate) === todayStr}
              url={"/daily/" + item.slug}
            />
          </li>
        ))
      }
    </ul>

    <!-- 分页 + 页码 -->
    <nav class="my-10 flex flex-wrap items-center justify-center gap-1" aria-label="分页导航">
      {
        currentPage > 1 ? (
          <a href={pageUrl(currentPage - 1)} class="btn btn-sm join-item" rel="prev">
            ← 上一页
          </a>
        ) : (
          <span class="btn btn-sm join-item btn-disabled">← 上一页</span>
        )
      }
      {
        pages.map((p) =>
          p === "…" ? (
            <span class="btn btn-sm join-item btn-disabled">…</span>
          ) : (
            <a
              href={pageUrl(p)}
              class:list={["btn", "btn-sm", "join-item", p === currentPage && "btn-active"]}
              aria-current={p === currentPage ? "page" : undefined}
            >
              {p}
            </a>
          )
        )
      }
      {
        currentPage < totalPages ? (
          <a href={pageUrl(currentPage + 1)} class="btn btn-sm join-item" rel="next">
            下一页 →
          </a>
        ) : (
          <span class="btn btn-sm join-item btn-disabled">下一页 →</span>
        )
      }
    </nav>
  </div>

  <!-- 搜索结果 -->
  <div id="daily-results" class="hidden">
    <ul class="space-y-3" id="daily-results-list"></ul>
    <div id="daily-empty" class="hidden py-16 text-center">
      <div class="text-3xl">🔍</div>
      <p class="mt-3 text-sm opacity-60">没有找到匹配的记录，换个关键词试试～</p>
      <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5 text-xs">
        <span class="opacity-50">试试：</span>
        {
          SUGGESTIONS.slice(0, 5).map((s) => (
            <button
              type="button"
              class="daily-suggest-btn rounded-full bg-base-200 px-2 py-0.5 opacity-70 hover:opacity-100"
              data-q={s}
            >
              {s}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <script id="daily-search-index" type="application/json" is:inline set:html={searchJson}></script>

  <script>
    const ESC = {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    };
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ESC[c]);
    const reEsc = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    function highlight(text, terms) {
      const safe = esc(text);
      if (!terms.length) return safe;
      const re = new RegExp("(" + terms.map(reEsc).join("|") + ")", "gi");
      return safe.replace(
        re,
        '<mark class="rounded bg-yellow-200/80 px-0.5 text-inherit">$1</mark>'
      );
    }

    function cardHtml(it, terms) {
      const tags = (it.g || [])
        .slice(0, 5)
        .map(
          (t) =>
            '<span class="rounded bg-base-200 px-1.5 py-0.5 text-[11px] opacity-70">#' +
            esc(t) +
            "</span>"
        )
        .join("");
      const img = it.i
        ? '<div class="shrink-0 overflow-hidden bg-base-200 sm:flex sm:w-[16rem] sm:items-center">' +
          '<img src="' +
          esc(it.i) +
          '" alt="' +
          esc(it.t) +
          '" loading="lazy" decoding="async" class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-[1.04] sm:aspect-[1080/460] sm:h-auto" />' +
          "</div>"
        : "";
      return (
        '<li><a href="' +
        esc(it.u) +
        '" class="group block overflow-hidden rounded-xl border border-base-300 bg-base-100 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"><div class="flex flex-col sm:flex-row">' +
        img +
        '<div class="flex min-w-0 flex-1 flex-col justify-center px-4 py-4 sm:px-5">' +
        '<div class="mb-1.5 flex flex-wrap items-center gap-2 text-xs opacity-60">' +
        '<time datetime="' +
        esc(it.s) +
        '" class="font-mono tracking-tight">' +
        esc(it.s) +
        "</time>" +
        (it.b ? '<span class="badge badge-sm badge-outline">' + esc(it.b) + "</span>" : "") +
        "</div>" +
        '<h2 class="line-clamp-2 text-lg font-bold leading-snug transition-colors group-hover:text-primary">' +
        highlight(it.t, terms) +
        "</h2>" +
        (it.d
          ? '<p class="mt-1.5 line-clamp-2 text-sm leading-relaxed opacity-70">' +
            highlight(it.d, terms) +
            "</p>"
          : "") +
        (tags ? '<div class="mt-2.5 flex flex-wrap gap-1.5">' + tags + "</div>" : "") +
        "</div></div></a></li>"
      );
    }

    /* ---------- 状态：跨 SPA 导航用 pathname 判定并重置 ---------- */
    const FILTER_LABEL = { all: "全部", ai: "AI 日报", life: "日常" };
    let activeFilter = "all";
    let indexCache = null;
    let lastPath = location.pathname;

    const $ = (id) => document.getElementById(id);

    function getIndex() {
      if (indexCache) return indexCache;
      const el = $("daily-search-index");
      if (!el) return [];
      try {
        indexCache = JSON.parse(el.textContent || "[]");
      } catch (e) {
        indexCache = [];
      }
      return indexCache;
    }

    function resetIfNavigated() {
      if (location.pathname !== lastPath) {
        lastPath = location.pathname;
        activeFilter = "all";
        indexCache = null;
      }
    }

    function paintFilter() {
      const box = $("daily-filter");
      if (!box) return;
      box.querySelectorAll("[data-filter]").forEach((btn) => {
        const on = btn.getAttribute("data-filter") === activeFilter;
        btn.setAttribute("data-active", on ? "true" : "false");
        btn.style.cssText = on ? "background-color:#2f7ddb !important;color:#fff !important;border-color:#2f7ddb !important;" : "";
        btn.setAttribute("aria-pressed", on ? "true" : "false");
      });
    }

    function apply() {
      const input = $("daily-search");
      const results = $("daily-results");
      const list = $("daily-results-list");
      const def = $("daily-default");
      const meta = $("daily-search-meta");
      const clearBtn = $("daily-search-clear");
      const suggest = $("daily-suggest");
      const empty = $("daily-empty");
      if (!input || !results || !list || !def || !meta) return;

      const index = getIndex();
      const raw = input.value.trim().toLowerCase();
      const terms = raw.split(/\s+/).filter(Boolean);
      const isDefault = terms.length === 0 && activeFilter === "all";

      if (clearBtn) {
        clearBtn.classList.toggle("hidden", terms.length === 0);
        clearBtn.classList.toggle("flex", terms.length > 0);
      }
      if (suggest) suggest.classList.toggle("hidden", !isDefault);

      if (isDefault) {
        results.classList.add("hidden");
        def.classList.remove("hidden");
        meta.classList.add("hidden");
        meta.textContent = "";
        list.innerHTML = "";
        return;
      }

      const hits = index.filter((it) => {
        if (activeFilter !== "all" && it.k !== activeFilter) return false;
        if (!terms.length) return true;
        const hay = (
          it.t + " " + it.d + " " + it.s + " " + it.b + " " + (it.g || []).join(" ")
        ).toLowerCase();
        return terms.every((t) => hay.indexOf(t) !== -1);
      });

      const shown = hits.slice(0, 60);
      list.innerHTML = shown.map((it) => cardHtml(it, terms)).join("");
      results.classList.remove("hidden");
      def.classList.add("hidden");
      meta.classList.remove("hidden");

      const scope = activeFilter === "all" ? "" : FILTER_LABEL[activeFilter] + " · ";
      const word = input.value.trim();
      if (hits.length === 0) {
        meta.textContent = scope + "没有找到" + (word ? "包含「" + word + "」的" : "") + "记录";
      } else {
        meta.textContent =
          scope +
          (word ? "「" + word + "」· " : "") +
          "找到 " +
          hits.length +
          " 条" +
          (hits.length > shown.length ? "（显示前 " + shown.length + " 条）" : "");
      }
      if (empty) empty.classList.toggle("hidden", hits.length > 0);
    }

    /** 每次页面就绪（首次加载 / SPA 导航后）都调用 */
    function bootstrap() {
      resetIfNavigated();
      paintFilter();
      const params = new URLSearchParams(location.search);
      const q = params.get("q");
      const f = params.get("f");
      if (f && ["all", "ai", "life"].indexOf(f) !== -1) activeFilter = f;
      const input = $("daily-search");
      if (input && q) input.value = q;
      if (q || (f && f !== "all")) apply();
    }

    /* ---------- 事件委托：绑定一次，SPA 换了 DOM 也照样有效 ---------- */
    function bindOnce() {
      if (window.__dailyDelegated) {
        bootstrap();
        return;
      }
      window.__dailyDelegated = true;

      document.addEventListener("input", (e) => {
        if (e.target && e.target.id === "daily-search") {
          resetIfNavigated();
          apply();
        }
      });

      document.addEventListener("click", (e) => {
        const t = e.target;
        if (!t || !t.closest) return;

        const fbtn = t.closest("#daily-filter [data-filter]");
        if (fbtn) {
          resetIfNavigated();
          activeFilter = fbtn.getAttribute("data-filter") || "all";
          const box = $("daily-filter");
          if (box) {
            box.querySelectorAll("[data-filter]").forEach((x) => {
              const on = x === fbtn;
              x.setAttribute("data-active", on ? "true" : "false");
              x.setAttribute("aria-pressed", on ? "true" : "false");
              (x as HTMLElement).style.cssText = on
                ? "background-color:#2f7ddb !important;color:#fff !important;border-color:#2f7ddb !important;"
                : "";
            });
          }
          apply();
          return;
        }

        if (t.closest("#daily-search-clear")) {
          const input = $("daily-search");
          if (input) {
            input.value = "";
            apply();
            input.focus();
          }
          return;
        }

        const sb = t.closest(".daily-suggest-btn");
        if (sb) {
          const input = $("daily-search");
          if (input) {
            resetIfNavigated();
            input.value = sb.getAttribute("data-q") || "";
            apply();
            input.focus();
          }
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.target && e.target.id === "daily-search" && e.key === "Escape") {
          e.target.value = "";
          apply();
          e.target.blur();
          return;
        }
        const t = e.target;
        const typing =
          t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable);
        if (!typing && e.key === "/") {
          const input = $("daily-search");
          if (input) {
            e.preventDefault();
            input.focus();
            input.select();
          }
        }
      });

      bootstrap();
    }

    document.addEventListener("astro:page-load", bootstrap);
    document.addEventListener("astro:after-swap", bootstrap);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindOnce);
    } else {
      bindOnce();
    }
  </script>
</BaseLayout>
