---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hi 你好 👋</div>
    <div class="text-5xl font-bold">我是 AChengLinus</div>
    <div class="text-3xl py-3 font-bold">毕业大专生 & 打工人Online</div>
    <div class="py-2">
      <text class="text-lg">
        这是我的 <b>博客</b> 我喜欢与信息技术有关的一切事情，它给了我一个契机，用自己的双手创造一切有趣的事物。<br>
        我会用 C++ 与 Python 写一些有意思的项目，偶尔也会想起以前打 OI 的时间， 不过都是往事了。<br>
        打工仍然是我的主要任务，有时，我会写一些学习笔记，尽管相较于纸质笔记来说没有什么用。<br>
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://www.acheng9616.com/" target="_blank"> 网站主页</a>
      <a href="https://www.acheng9616.com/about.html#/qa" target="_blank" class="btn btn-outline ml-5">
        公告
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">项目进度.... </div>
  </div>

  <HorizontalCard
    title="网站主页"
    img="/images/site/itemPreview.webp"
    desc="在这里你能了解公告内容"
    url="https://www.acheng9616.com/"
    badge="运行中"
  />
  <div class="divider my-0"></div>
  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">知识分享</div>
  </div>

  <div class="mb-5">
    <input
      id="search-input"
      type="text"
      placeholder="搜索笔记..."
      class="input input-bordered w-full"
      oninput="filterPosts(this.value)"
    />
  </div>

  <div id="posts-container">
  {
    posts.map((post) => (
      <div class="post-item">
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
          tags={post.data.tags}
          date={post.data.pubDate}
        />
        <div class="divider my-0" />
      </div>
    ))
  }
  </div>
</BaseLayout>

<script>
  function filterPosts(value) {
    const items = document.querySelectorAll(".post-item");
    const keywords = value.trim().toLowerCase();
    items.forEach((item) => {
      const text = item.textContent.toLowerCase();
      if (!keywords) {
        item.style.display = "";
        return;
      }
      // 单字匹配：检查每个字符是否都出现在文本中
      const match = keywords.split("").every((char) => text.includes(char));
      item.style.display = match ? "" : "none";
    });
  }
</script>
