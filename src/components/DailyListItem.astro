---
/**
 * 日常吐槽列表项：左侧当天配图 + 右侧文字记录
 * 用于「日常吐槽」列表页，也复用于站内搜索结果的前端渲染（结构与内联脚本保持一致）
 */
interface Props {
  title: string;
  desc?: string;
  img?: string;
  url: string;
  badge?: string;
  /** 已格式化的日期，如 2026-10-31 */
  date?: string;
  /** 星期，如 周五 */
  weekday?: string;
  tags?: string[];
  isToday?: boolean;
}

const {
  title,
  desc,
  img,
  url,
  badge,
  date,
  weekday,
  tags = [],
  isToday = false,
} = Astro.props;
---

<a
  href={url}
  class="group block overflow-hidden rounded-xl border border-base-300 bg-base-100 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"
>
  <div class="flex flex-col sm:flex-row">
    {
      img && (
        <div class="shrink-0 overflow-hidden bg-base-200 sm:flex sm:w-[16rem] sm:items-center">
          <img
            src={img}
            alt={title}
            loading="lazy"
            decoding="async"
            class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-[1.04] sm:aspect-[1080/460] sm:h-auto"
          />
        </div>
      )
    }
    <div class="flex min-w-0 flex-1 flex-col justify-center px-4 py-4 sm:px-5">
      <div class="mb-1.5 flex flex-wrap items-center gap-2 text-xs opacity-60">
        {date && <time datetime={date} class="font-mono tracking-tight">{date}</time>}
        {weekday && <span>{weekday}</span>}
        {isToday && <span class="badge badge-sm border-0 bg-primary/15 text-primary">今日</span>}
        {badge && <span class="badge badge-sm badge-outline">{badge}</span>}
      </div>
      <h2 class="text-lg font-bold leading-snug transition-colors group-hover:text-primary line-clamp-2">
        {title}
      </h2>
      {
        desc && (
          <p class="mt-1.5 text-sm leading-relaxed opacity-70 line-clamp-2">{desc}</p>
        )
      }
      {
        tags.length > 0 && (
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {tags.slice(0, 5).map((t) => (
              <span class="rounded bg-base-200 px-1.5 py-0.5 text-[11px] opacity-70">#{t}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</a>
