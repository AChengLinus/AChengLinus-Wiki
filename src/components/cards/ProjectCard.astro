---
/**
 * 项目卡片（竖版）：封面图 + 标题 + 徽章 + 描述 + 域名
 * 用于 /projects 页面的网格布局
 */
interface Props {
  title: string;
  desc?: string;
  img?: string;
  url: string;
  badge?: string;
  /** 显示在卡片底部的域名，如 tool.acheng9616.com */
  host?: string;
}

const { title, desc, img, url, badge, host } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col overflow-hidden rounded-xl border border-base-300 bg-base-100 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"
>
  <div class="aspect-[16/10] overflow-hidden bg-base-200">
    {
      img ? (
        <img
          src={img}
          alt={title}
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-4xl opacity-20">📦</div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-4">
    <div class="mb-1 flex items-start justify-between gap-2">
      <h2 class="font-bold leading-snug transition-colors group-hover:text-primary">{title}</h2>
      {badge && <span class="badge badge-sm badge-outline shrink-0">{badge}</span>}
    </div>
    {desc && <p class="mt-1 line-clamp-2 text-sm leading-relaxed opacity-70">{desc}</p>}
    {host && <div class="mt-auto pt-3 font-mono text-xs opacity-40">{host}</div>}
  </div>
</a>
