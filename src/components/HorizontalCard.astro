---
const { title, img, desc, url, badge, tags, target = "_blank", date } = Astro.props;
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";

const formatDate = (d) => {
  if (!d) return "";
  const dateObj = typeof d === "string" ? new Date(d) : d;
  return `${dateObj.getFullYear()}-${String(dateObj.getMonth() + 1).padStart(2, "0")}-${String(dateObj.getDate()).padStart(2, "0")}`;
};
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <img
            src={img}
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <div class="flex items-center justify-between">
          <h1 class="text-xl font-bold">
            {title}
            {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
          </h1>
          {date && <span class="text-sm opacity-60">{formatDate(date)}</span>}
        </div>
        <p class="py-1 text-1xl">{desc}</p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
