---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends BlogSchema {}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll")
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article" wide>
  <main class="md:flex md:justify-center md:gap-8">
    <article class="prose prose-lg max-w-[750px] prose-img:mx-auto">
      <a href="/blog" class="btn btn-ghost btn-sm pl-0 mb-4">&larr; 返回笔记列表</a>
      {heroImage && <img src={heroImage} alt={title} class="w-full mb-6" />}
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {pubDate && <time>{displayDate}</time>}
      <br />
      {badge && <div class="badge badge-secondary my-1">{badge}</div>}
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="badge badge-outline ml-2 no-underline">
              {tag}
            </a>
          ))
      }
      {
        updatedDate && (
          <div>
            {" "}
            Last updated on <time>{updatedDate}</time>{" "}
          </div>
        )
      }
      <div class="divider my-2"></div>
      <slot />
    </article>

    <aside id="toc-sidebar" class="hidden xl:block w-56 shrink-0">
      <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
        <nav class="border-l-2 border-base-300 pl-4 text-sm">
          <p class="font-bold mb-2 text-base-content/60">目录</p>
          <ul id="toc-list" class="space-y-2">
          </ul>
        </nav>
      </div>
    </aside>
  </main>
</BaseLayout>

<script>
  // 从文章 DOM 中提取 h2/h3 生成目录
  document.addEventListener("DOMContentLoaded", function () {
    const article = document.querySelector("article");
    const tocList = document.getElementById("toc-list");
    const tocSidebar = document.getElementById("toc-sidebar");
    if (!article || !tocList || !tocSidebar) return;

    const headings = article.querySelectorAll("h2, h3");
    if (headings.length === 0) {
      tocSidebar.classList.add("hidden");
      return;
    }

    headings.forEach((h) => {
      const slug = h.id || h.textContent.trim().toLowerCase().replace(/\s+/g, "-").replace(/[^\w一-鿿-]/g, "");
      if (!h.id) h.id = slug;

      const li = document.createElement("li");
      if (h.tagName === "H3") li.classList.add("ml-4");

      const a = document.createElement("a");
      a.href = "#" + slug;
      a.className = "text-base-content/60 hover:text-primary transition-colors no-underline block";
      a.textContent = h.textContent;

      li.appendChild(a);
      tocList.appendChild(li);
    });

    tocSidebar.classList.remove("hidden");
  });
</script>