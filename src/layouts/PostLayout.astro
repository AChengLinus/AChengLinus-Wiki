---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends BlogSchema {
  toc?: { depth: number; text: string; slug: string }[];
}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [], toc = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll")
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article" wide>
  <main class="md:flex md:justify-center md:gap-8">
    <article class="prose prose-lg max-w-[750px] prose-img:mx-auto">
      <a href="/blog" class="btn btn-ghost btn-sm pl-0 mb-4">&larr; 返回笔记列表</a>
      {heroImage && <img src={heroImage} alt={title} class="w-full mb-6" />}
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {pubDate && <time>{displayDate}</time>}
      <br />
      {badge && <div class="badge badge-secondary my-1">{badge}</div>}
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="badge badge-outline ml-2 no-underline">
              {tag}
            </a>
          ))
      }
      {
        updatedDate && (
          <div>
            {" "}
            Last updated on <time>{updatedDate}</time>{" "}
          </div>
        )
      }
      <div class="divider my-2"></div>
      <slot />
    </article>

    {
      toc.length > 0 && (
        <aside class="hidden xl:block w-40 shrink-0">
          <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
            <nav class="border-l-2 border-base-300 pl-4 text-sm">
              <p class="font-bold mb-2 text-base-content/60">目录</p>
              <ul class="space-y-2">
                {
                  toc.map((item) => (
                    <li class={item.depth === 3 ? "ml-4" : ""}>
                      <a href={"#" + item.slug} class="text-base-content/60 hover:text-primary transition-colors no-underline block">{item.text}</a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </aside>
      )
    }
  </main>
</BaseLayout>

{
  toc.length > 0 && (
    <script is:inline>
      (function() {
        var article = document.querySelector("article");
        if (!article) return;
        var hs = article.querySelectorAll("h2, h3");
        for (var i = 0; i < hs.length; i++) {
          var h = hs[i];
          if (!h.id) {
            h.id = h.textContent.trim().toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9一-鿿-]/g, "");
          }
        }
      })();
    </script>
  )
}