---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends BlogSchema {
  toc?: { depth: number; text: string; slug: string }[];
}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [], toc = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll")
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article" wide>
  <a href="/blog" class="mb-4 inline-flex btn btn-sm shadow-sm bg-base-100/80 backdrop-blur-sm rounded-full lg:fixed lg:top-20 lg:left-[calc(19rem+1rem)] lg:z-50 lg:mb-0">&larr; 返回笔记列表</a>
  <main class="md:flex md:justify-center md:gap-8">
    <article class="prose prose-lg w-full max-w-[750px] prose-img:mx-auto">
      {heroImage && <img src={heroImage} alt={title} class="w-full mb-6" />}
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {pubDate && <time>{displayDate}</time>}

      <!-- 工具条：分享 + 简洁模式 -->
      <div id="share-bar" class="not-prose my-3 flex flex-wrap items-center gap-1 text-xs">
        <button type="button" data-action="copy" class="btn btn-xs btn-ghost gap-1">🔗 复制链接</button>
        <button type="button" data-action="native" class="btn btn-xs btn-ghost gap-1">📤 分享</button>
        <button type="button" data-action="wechat" class="btn btn-xs btn-ghost gap-1">💬 微信文案</button>
        <span class="grow"></span>
        <button type="button" data-action="reader" id="reader-toggle" class="btn btn-xs btn-ghost gap-1">📖 简洁模式</button>
      </div>

      <br />
      {badge && <div class="badge badge-secondary my-1">{badge}</div>}
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="badge badge-outline ml-2 no-underline">
              {tag}
            </a>
          ))
      }
      {
        updatedDate && (
          <div>
            {" "}
            Last updated on <time>{updatedDate}</time>{" "}
          </div>
        )
      }
      <div class="divider my-2"></div>
      <slot />
    </article>

    {
      toc.length > 0 && (
        <aside id="toc-panel" class="hidden xl:block w-80 shrink-0">
          <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
            <nav class="border-l-2 border-base-300 pl-4 text-sm">
              <p class="font-bold mb-2 text-base-content/60">本页内容</p>
              <ul id="toc-list" class="space-y-2">
                {
                  toc.map((item) => (
                    <li class={item.depth === 3 ? "ml-4" : ""}>
                      <a href={"#" + item.slug} class="toc-link text-base-content/60 hover:text-primary transition-all duration-300 no-underline block">{item.text}</a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </aside>
      )
    }
  </main>
</BaseLayout>

{
  toc.length > 0 && (
    <script is:inline>
      (function() {
        var article = document.querySelector("article");
        if (!article) return;

        // 给标题生成 id（兼容无 id 的情况）
        var hs = article.querySelectorAll("h2, h3");
        for (var i = 0; i < hs.length; i++) {
          var h = hs[i];
          if (!h.id) {
            h.id = h.textContent.trim().toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9一-鿿-]/g, "");
          }
        }

        // 滚动监听：高亮当前可见的目录项
        var links = document.querySelectorAll(".toc-link");
        if (links.length === 0) return;

        // 点击目录项：平滑滚动到对应章节（留 6rem 偏移）
        for (var li = 0; li < links.length; li++) {
          links[li].addEventListener("click", function (ev) {
            var href = this.getAttribute("href") || "";
            if (href.charAt(0) !== "#") return;
            var targetId = href.slice(1);
            try { targetId = decodeURIComponent(targetId); } catch (e2) {}
            var target = document.getElementById(targetId);
            if (!target) return;
            ev.preventDefault();
            var targetY = Math.max(0, target.getBoundingClientRect().top + window.scrollY - 96);
            window.scrollTo({ top: targetY, behavior: "smooth" });
            try { history.replaceState(null, "", "#" + encodeURIComponent(targetId)); } catch (e3) {}
          });
        }

        // 先移除所有 active，再高亮指定项
        function setActive(id) {
          for (var i = 0; i < links.length; i++) {
            var link = links[i];
            if (link.getAttribute("href") === "#" + id) {
              link.classList.remove("text-base-content/60", "font-normal");
              link.classList.add("text-primary", "font-bold");
            } else {
              link.classList.remove("text-primary", "font-bold");
              link.classList.add("text-base-content/60", "font-normal");
            }
          }
        }

        var observer = new IntersectionObserver(function(entries) {
          var visible = [];
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              visible.push(entries[i].target);
            }
          }
          if (visible.length > 0) {
            // 选最靠上的可见标题
            var top = visible[0];
            for (var i = 1; i < visible.length; i++) {
              if (visible[i].getBoundingClientRect().top < top.getBoundingClientRect().top) {
                top = visible[i];
              }
            }
            setActive(top.id);
          }
        }, { rootMargin: "-80px 0px -60% 0px" });

        for (var i = 0; i < hs.length; i++) {
          observer.observe(hs[i]);
        }
      })();
    </script>
  )
}

<script>
  function postToast(msg: string) {
    let el = document.getElementById("site-toast") as HTMLDivElement | null;
    if (!el) {
      el = document.createElement("div");
      el.id = "site-toast";
      el.className =
        "fixed bottom-8 left-1/2 z-[100] -translate-x-1/2 rounded-lg bg-neutral px-4 py-2 text-sm text-neutral-content shadow-lg transition-opacity duration-200";
      el.style.opacity = "0";
      document.body.appendChild(el);
    }
    el.textContent = msg;
    el.style.opacity = "1";
    clearTimeout((el as any)._t);
    (el as any)._t = setTimeout(() => {
      if (el) el.style.opacity = "0";
    }, 1800);
  }

  function postToggleReader(force?: boolean) {
    const root = document.documentElement;
    const on = typeof force === "boolean" ? force : !root.classList.contains("reader-mode");
    root.classList.toggle("reader-mode", on);
    try {
      localStorage.setItem("blog-reader", on ? "1" : "0");
    } catch (e) {}
    const btn = document.getElementById("reader-toggle");
    if (btn) btn.textContent = on ? "📖 退出简洁模式" : "📖 简洁模式";
  }

  async function postCopyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch (e) {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.top = "-9999px";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch (e2) {}
      document.body.removeChild(ta);
      return ok;
    }
  }

  function setupPostShare() {
    const bar = document.getElementById("share-bar");
    if (!bar || (bar as HTMLElement).dataset.bound === "1") return;
    (bar as HTMLElement).dataset.bound = "1";

    bar.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest("[data-action]");
      if (!btn) return;
      const action = btn.getAttribute("data-action");
      const url = location.href.split("#")[0];
      const heading = document.querySelector("article h1")?.textContent?.trim() || document.title;

      if (action === "reader") {
        postToggleReader();
        return;
      }
      if (action === "native" && navigator.share) {
        try {
          await navigator.share({ title: heading, url });
        } catch (err) {}
        return;
      }
      if (action === "wechat") {
        const ok = await postCopyText(`${heading}\n${url}`);
        postToast(ok ? "已复制，粘贴到微信发送即可" : "复制失败，请手动复制地址栏链接");
        return;
      }
      const ok = await postCopyText(url);
      postToast(ok ? "链接已复制" : "复制失败，请手动复制地址栏链接");
    });
  }

  function initPostTools() {
    setupPostShare();
    try {
      if (localStorage.getItem("blog-reader") === "1") postToggleReader(true);
    } catch (e) {}
    document.querySelectorAll("article img").forEach((img) => {
      if (!img.getAttribute("loading")) img.setAttribute("loading", "lazy");
    });
  }

  document.addEventListener("astro:page-load", initPostTools);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPostTools);
  } else {
    initPostTools();
  }
</script>